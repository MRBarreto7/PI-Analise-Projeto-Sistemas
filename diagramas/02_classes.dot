digraph G {graph[label="Diagrama de Classes — Modelo conceitual",labelloc=t,fontsize=19,fontname="DejaVu Sans",bgcolor=white,rankdir=LR,nodesep=.32,ranksep=.85,splines=polyline]; node[shape=record,fontname="DejaVu Sans",fontsize=10,style=filled,fillcolor="#eff5fa",color="#486984"]; edge[fontname="DejaVu Sans",fontsize=9,color="#506a7d",arrowhead=none]; Usuario[label="{Usuario|id; nome; email; papel|autenticar()}"]; TCC[label="{TCC|id; titulo; tema; situacao|calcularProgresso()}"]; Etapa[label="{Etapa|id; nome; ordem; prazo; status|atualizarStatus()}"]; Orientacao[label="{Orientacao|id; data; assuntos; encaminhamentos|registrar()}"]; Entrega[label="{Entrega|id; versao; dataHora; arquivoOuLink; foraPrazo|enviar()}"]; Avaliacao[label="{Avaliacao|id; nota; observacoes; decisao|registrar()}"]; Banca[label="{Banca|id; dataDefesa|compor()}"]; Participacao[label="{MembroBanca|papel|associar()}"]; Parecer[label="{ParecerAdmissibilidade|id; data; apto; justificativa|emitir()}"]; Usuario -> TCC [label="aluno 1 : 0..* TCC"]; Usuario -> TCC [label="orientador 1 : 0..* TCC"]; TCC -> Etapa[label="1 : 1..*"]; TCC -> Orientacao[label="1 : 0..*"]; Etapa -> Entrega[label="1 : 0..*"]; Entrega -> Avaliacao[label="1 : 0..*"]; TCC -> Parecer[label="1 : 0..*"]; TCC -> Banca[label="1 : 0..1"]; Banca -> Participacao[label="1 : 1..*"]; Participacao -> Usuario[label="* : 1 avaliador"]; }