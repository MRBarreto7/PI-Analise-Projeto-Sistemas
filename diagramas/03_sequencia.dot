digraph G {graph[label="Diagrama de Sequência — Registrar entrega e avaliar",labelloc=t,fontsize=18,fontname="DejaVu Sans",bgcolor=white,rankdir=TB, nodesep=.35,ranksep=.24];node[shape=box,style="rounded,filled",fillcolor="#eef5fa",color="#54758c",fontname="DejaVu Sans",fontsize=10]; edge[fontname="DejaVu Sans",fontsize=9,color="#536e83"]; a[label="Aluno"]; ui[label="Interface"]; api[label="Sistema / API"]; repo[label="Repositório"]; v[label="Avaliador autorizado"]; a->ui[label="1. Selecionar etapa e anexar material"];ui->api[label="2. Solicitar envio"];api->api[label="3. Validar acesso, formato e prazo"];api->repo[label="4. Gravar entrega e versão"];repo->api[label="5. Confirmar persistência"];api->ui[label="6. Exibir protocolo/status"];ui->v[label="7. Entrega pendente fica disponível"];v->api[label="8. Registrar nota e observações"];api->api[label="9. Validar nota e regra de aprovação"];api->repo[label="10. Gravar avaliação e atualizar etapa"];api->ui[label="11. Disponibilizar feedback ao aluno"]; }