digraph G { graph [rankdir=TB, bgcolor="white", pad=.28, nodesep=.3, ranksep=.5, fontname="DejaVu Sans", label="DIAGRAMA DE COMPONENTES  |  Sistema de Gestão de TCC", labelloc=t, fontsize=17]; node[shape=box,style="rounded,filled",fillcolor="#eef5fc",color="#5c80a8",fontname="DejaVu Sans",fontsize=10]; edge[fontname="DejaVu Sans",fontsize=9,color="#536275"]; U[label="Usuários (4 perfis)",fillcolor="#f0f0f0"]; W[label="«component» Interface Web"]; API[label="«component» API / Autorização"]; U->W[label="HTTPS"];W->API[label="REST/JSON"]; subgraph cluster_mod {label="Módulos de negócio"; style="rounded,dashed"; color="#9daabc"; US[label="«component» Usuários"]; TC[label="«component» TCC e Etapas"]; EN[label="«component» Entregas"]; AV[label="«component» Orientações e Avaliações"]; BA[label="«component» Bancas / Defesa"]; {rank=same;US;TC;EN;AV;BA;} } API->US[label="IUsuarios",style=dashed]; API->TC[label="ITCC",style=dashed];API->EN[label="IEntregas",style=dashed];API->AV[label="IAvaliacoes",style=dashed];API->BA[label="IBancas",style=dashed]; PER[label="«component» Persistência"];DB[label="«database» PostgreSQL",fillcolor="#fff7e2"];FS[label="«external» Armazenamento de arquivos",fillcolor="#fff7e2"];US->PER;TC->PER;EN->PER;AV->PER;BA->PER;PER->DB[label="SQL/TCP"];EN->FS[label="HTTPS"]; }