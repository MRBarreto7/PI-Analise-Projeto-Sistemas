digraph G {graph[label="Diagrama de Atividades — Entrega e avaliação",labelloc=t,fontsize=19,fontname="DejaVu Sans",bgcolor=white,rankdir=TB,nodesep=.27,ranksep=.35];node[shape=box,style="rounded,filled",fillcolor="#eef5fa",color="#587990",fontname="DejaVu Sans",fontsize=10,margin=".17,.10"]; edge[fontname="DejaVu Sans",fontsize=9,color="#536e83"];inicio[shape=circle,label="",width=.2,style=filled,fillcolor="#304d65"];fim[shape=doublecircle,label="",width=.25,style=filled,fillcolor="#304d65"];entrega[label="Aluno envia arquivo ou link"];material[shape=diamond,label="Material válido?"];erro[label="Exibir erro; solicitar correção",fillcolor="#fff1ed"];salvar[label="Registrar versão e data/hora\n(indicar atraso, se aplicável)"];avaliar[label="Orientador ou banca autorizada\nregistra nota e feedback"];nota[shape=diamond,label="Nota ≥ 7?"];aprovado[label="Concluir etapa e atualizar progresso",fillcolor="#e8f3e8"];reelab[label="Registrar ajustes e abrir\nnova entrega (7 dias)",fillcolor="#fff1ed"];inicio->entrega->material;material->erro[label="não"];erro->entrega;material->salvar[label="sim"];salvar->avaliar->nota;nota->aprovado[label="sim"];nota->reelab[label="não"];reelab->entrega;aprovado->fim;}